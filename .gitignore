# ── MARK LVII — what never belongs in the repository ──────────────────────────
# Everything listed here is created by the app on first run or holds user secrets.

# Secrets — committing any of these publishes them
config/api_keys.json
config/homelab_config.json
config/hardware_devices.json
config/certs/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*

# Personal data
memory/long_term.json
memory/*.db
memory/routines.json

# Python build noise
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editors and operating systems
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Runtime output
*.log
logs/
downloads/
screenshots/
package-lock.json

memory/knowledge_graph.db
memory/knowledge_graph.db-wal
memory/knowledge_graph.db-shm
